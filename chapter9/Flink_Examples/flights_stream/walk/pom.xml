<?xml version="1.0" encoding="UTF-8"?>
<!-- The job FlightsWalk of the air traffic use case of chapter 9: the position rule and the
     reachability rule applied online to the state vectors of the topic flights-states. Flink is
     provided by the installation of PyFlink that runs the other examples of the chapter, whose
     directory lib holds the jars of Flink and of its Kafka connector. MobilityFlink, JMEOS and
     their dependencies are copied into target/lib by `mvn package`; MobilityFlink is installed
     in the local Maven repository by its own build (mvn install in its repository).

       mvn package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.mobilitydb.book</groupId>
    <artifactId>flights-walk</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <flink.version>2.1.3</flink.version>
        <mobilityflink.version>1.0-SNAPSHOT</mobilityflink.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The MEOS facades and the SQL surface of MobilityFlink, with JMEOS and jnr-ffi; the
             jars of Flink come from the installation that runs the job -->
        <dependency>
            <groupId>org.mobilitydb.flink</groupId>
            <artifactId>mobility-flink-binding</artifactId>
            <version>${mobilityflink.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
